node_modules/
dist/
.env
.env.*
!.env.example
*.log
artifacts/

# 部署包产物
deploy/*.tar.gz
deploy/*.zip

# 云端数据库本地备份（含成员邮箱等敏感信息，只留本机，绝不进仓库）
backups/

# 采集原始数据：含供应商联系人、电话、原文链接，只留本机与云端数据库，不进公开仓库
# 注意必须写成 data/* 而不是 data/：目录整体被忽略时，git 不会进入目录，
# 后面的 !data/pending/ 无效，队列文件就永远提交不上去。
data/*
# 例外：本机 → Actions 的中转队列。只含公开字段（标题 / 价格 / 地区 / 原文链接），
# 用于把境外节点抓不到的国内源（禽网系列等）搬进云端；入库成功后由 Actions 删除。
!data/pending/
!data/pending/*.json

# 线索离线页：内嵌完整线索数据，不发布、不进仓库
leads.html
